{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutrons.org/snapwrap/reduction_artefacts/run_manifest.schema.json",
  "title": "Reduction Artefacts Run Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "timestamp",
    "ipts",
    "run_number",
    "campaign_id",
    "campaign_slug",
    "assembly_type",
    "selected_artefacts"
  ],
  "properties": {
    "manifest_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "ipts": { "type": "integer", "minimum": 1 },
    "run_number": { "type": "integer", "minimum": 1 },
    "campaign_id": { "type": "integer", "minimum": 1 },
    "campaign_slug": { "type": "string" },
    "assembly_type": { "type": "string", "enum": ["DAC", "PE", "OTHER"] },
    "state_id": { "type": ["string", "null"] },
    "selected_artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artefact_id", "artefact_type", "version", "path", "method"],
        "properties": {
          "artefact_id": { "type": "string" },
          "artefact_type": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "path": { "type": "string" },
          "method": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
