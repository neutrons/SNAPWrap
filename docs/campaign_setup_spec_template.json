        "ws_name": "pe_pixel_mask",
        "notes": "Standard PE letterbox pixel mask"
      }
    ],
    "planned_attenuations": [
      {
        "artefact_id": "atten-pe-run10001",
        "notes": "Attenuation workspace — to be computed once transmission monitor workflow is available"
      }
